{
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait permission", "timeout": 5 }]
      },
      {
        "matcher": "elicitation_dialog|agent_needs_input",
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait input", "timeout": 5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait question", "timeout": 5 }]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait plan", "timeout": 5 }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh arm", "timeout": 5 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait done", "timeout": 5 }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh wait error", "timeout": 5 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh off", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh off tool", "timeout": 5 }]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh off tool", "timeout": 5 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "sh ~/.claude/hooks/attention.sh off end", "timeout": 5 }]
      }
    ]
  }
}
